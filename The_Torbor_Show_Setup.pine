// =============================================================================
// The Torbor Show Setup - Cleaned & GitHub Ready
// =============================================================================
// Version: 1.3
// Pine Script: v6
// 
// Description:
//   A multi-confirmation strategy combining:
//   - Supertrend flips
//   - WaveTrend green/red signals (oversold/overbought crosses)
//   - Price relative to 200 MA (chart TF + 1m), 21 SMA, 50 SMA
//   - RSI & MACD filters
//   - ATR-based stop loss & take profit
//
// Visual signals (no circle dots, no 1m cross markers):
//   - Entry signals: small triangles
//   - 200 MA crosses (chart TF): small diamonds
//   All signal plots support show_last to avoid chart crowding.
//
// Free TradingView compatible:
//   All calculations work fully on free accounts.
//
// Disclaimer:
//   This is an educational / research script. Past performance is not indicative
//   of future results. Always backtest thoroughly and use proper risk management.
//   Not financial advice.
// =============================================================================

//@version=6
strategy("The Torbor Show Setup", 
     overlay=true, 
     initial_capital=15000, 
     default_qty_value=10000, 
     default_qty_type=strategy.cash, 
     commission_type=strategy.commission.percent, 
     commission_value=0.1,
     pyramiding=0,
     calc_on_every_tick=false,
     margin_long=100,
     margin_short=100)

// =============================================================================
// INPUTS
// =============================================================================

// --- Display / Anti-clutter ---
grpDisplay = "Display & Signals"
showEntrySignals   = input.bool(true,  "Show Entry Signals (triangles)", group=grpDisplay)
showChartMaCrosses = input.bool(true,  "Show Chart TF 200 MA Crosses",   group=grpDisplay)
maxSignals         = input.int(80,     "Max Signals to Show (show_last)", minval=10, maxval=500, group=grpDisplay, tooltip="Limits historical shapes so the chart stays clean")

// --- RSI ---
grpRsi = "RSI"
rsiLength     = input.int(14, "RSI Length",     group=grpRsi)
rsiOverbought = input.int(80, "RSI Overbought", group=grpRsi)
rsiOversold   = input.int(20, "RSI Oversold",   group=grpRsi)

// --- MACD ---
grpMacd = "MACD"
macdFast   = input.int(8,  "MACD Fast",   group=grpMacd)
macdSlow   = input.int(17, "MACD Slow",   group=grpMacd)
macdSignal = input.int(9,  "MACD Signal", group=grpMacd)

// --- Moving Averages ---
grpMa = "Moving Averages"
maLength    = input.int(200, "MA Length", group=grpMa)
maType      = input.string("SMA", "MA Type", options=["SMA", "EMA"], group=grpMa)
ma800Length = input.int(800, "Long MA Length (800)", group=grpMa)

// --- WaveTrend ---
grpMc = "WaveTrend"
wtChannelLen = input.int(9,  "Channel Length", group=grpMc)
wtAvgLen     = input.int(12, "Average Length", group=grpMc)
wtOB         = input.int(60, "Overbought Level", group=grpMc)
wtOS         = input.int(-60,"Oversold Level",   group=grpMc)

// --- Supertrend ---
grpSt = "Supertrend"
stFactor    = input.float(3.0, "Factor",     group=grpSt)
stAtrPeriod = input.int(10,    "ATR Period", group=grpSt)

// --- Risk Management ---
grpRisk = "Risk Management (ATR)"
atrLength = input.int(14,    "ATR Length", group=grpRisk)
slMult    = input.float(1.5, "SL Multiplier", group=grpRisk)
tpMult    = input.float(3.0, "TP Multiplier", group=grpRisk)

// =============================================================================
// INDICATORS
// =============================================================================

// RSI
rsi = ta.rsi(close, rsiLength)

// MACD
[macdLine, signalLine, _] = ta.macd(close, macdFast, macdSlow, macdSignal)

// Moving Averages (chart timeframe)
ma_expr = maType == "EMA" ? ta.ema(close, maLength) : ta.sma(close, maLength)
ma      = ma_expr

ma800_expr = maType == "EMA" ? ta.ema(close, ma800Length) : ta.sma(close, ma800Length)
ma800      = ma800_expr

sma21 = ta.sma(close, 21)
sma50 = ta.sma(close, 50)

// Higher / lower timeframe MAs
ma1m      = request.security(syminfo.tickerid, "1",  ma_expr,    gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ma800_15m = request.security(syminfo.tickerid, "15", ma800_expr, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Channel (20-period SMA of high/low)
upper20 = ta.sma(high, 20)
lower20 = ta.sma(low,  20)

// Supertrend
[supertrend, direction] = ta.supertrend(stFactor, stAtrPeriod)
stBullFlip = direction == -1 and direction[1] == 1
stBearFlip = direction == 1  and direction[1] == -1

// WaveTrend
esa = ta.ema(hlc3, wtChannelLen)
d   = ta.ema(math.abs(hlc3 - esa), wtChannelLen)
ci  = (hlc3 - esa) / (0.015 * d)
wt1 = ta.ema(ci, wtAvgLen)
wt2 = ta.sma(wt1, 3)

mcGreenDot = ta.crossover(wt1, wt2) and wt1 < wtOS
mcRedDot   = ta.crossunder(wt1, wt2) and wt1 > wtOB

// ATR
atr = ta.atr(atrLength)

// Chart TF 200 MA crosses
bool bullishCross = ta.crossover(close, ma)
bool bearishCross = ta.crossunder(close, ma)

// =============================================================================
// ENTRY CONDITIONS
// =============================================================================

bool longCondition = stBullFlip and 
                     close > ma and close > ma1m and close > sma21 and close > lower20 and 
                     mcGreenDot and rsi < 50 and macdLine > signalLine

bool shortCondition = stBearFlip and 
                      close < ma and close < ma1m and close < sma21 and close < upper20 and 
                      mcRedDot and macdLine < signalLine

// =============================================================================
// STRATEGY LOGIC
// =============================================================================

if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

// Close opposite position on counter signal
if shortCondition
    strategy.close("Long", comment="Counter Signal")
if longCondition
    strategy.close("Short", comment="Counter Signal")

// ATR-based SL / TP (set once on entry)
if strategy.position_size > 0 and strategy.position_size[1] <= 0
    strategy.exit("Exit Long", "Long", 
         stop=close - atr * slMult, 
         limit=close + atr * tpMult)

if strategy.position_size < 0 and strategy.position_size[1] >= 0
    strategy.exit("Exit Short", "Short", 
         stop=close + atr * slMult, 
         limit=close - atr * tpMult)

// =============================================================================
// PLOTS
// =============================================================================

// Moving Averages
plot(ma,       "200 MA",        color=color.new(#FFFF00, 0), linewidth=2)
plot(ma1m,     "1m 200 MA",     color=color.new(#FF0000, 0), linewidth=1)
plot(ma800,    "800 MA",        color=color.new(#B0B0B0, 0), linewidth=1)
plot(ma800_15m,"15m 800 MA",    color=color.new(#FFFFFF, 0), linewidth=1)
plot(sma50,    "50 SMA",        color=color.new(#00FFFF, 0))
plot(sma21,    "21 SMA",        color=color.new(#A020F0, 0))

// Channel fill (upper/lower 20 SMA)
p_upper = plot(upper20, "Upper 20", color=color.new(#0000FF, 0))
p_lower = plot(lower20, "Lower 20", color=color.new(#FF8C00, 0))
fill(p_upper, p_lower, color=color.new(#00FFFF, 90), title="Channel Fill")

// Supertrend
plot(supertrend, "Supertrend", 
     color=direction == -1 ? color.new(color.green, 0) : color.new(color.red, 0), 
     linewidth=2)

// =============================================================================
// SIGNAL PLOTS (clean, non-circle, anti-clutter)
// =============================================================================

// Entry signals — triangles
plotshape(showEntrySignals and longCondition, 
     title="Long Entry", 
     style=shape.triangleup, 
     location=location.belowbar, 
     color=color.new(#00FF00, 0), 
     size=size.small, 
     show_last=maxSignals)

plotshape(showEntrySignals and shortCondition, 
     title="Short Entry", 
     style=shape.triangledown, 
     location=location.abovebar, 
     color=color.new(#FF0000, 0), 
     size=size.small, 
     show_last=maxSignals)

// Chart TF 200 MA crosses — small diamonds
plotshape(showChartMaCrosses and bullishCross, 
     title="200 MA Bullish Cross", 
     style=shape.diamond, 
     location=location.belowbar, 
     color=color.new(color.aqua, 0), 
     size=size.tiny, 
     show_last=maxSignals)

plotshape(showChartMaCrosses and bearishCross, 
     title="200 MA Bearish Cross", 
     style=shape.diamond, 
     location=location.abovebar, 
     color=color.new(#FF1493, 0), 
     size=size.tiny, 
     show_last=maxSignals)

// =============================================================================
// ALERTS
// =============================================================================

if bullishCross
    alert("200 MA Bullish Cross", alert.freq_once_per_bar_close)
if bearishCross
    alert("200 MA Bearish Cross", alert.freq_once_per_bar_close)

if longCondition
    alert("Torbor Long Entry Signal", alert.freq_once_per_bar_close)
if shortCondition
    alert("Torbor Short Entry Signal", alert.freq_once_per_bar_close)

// =============================================================================
// END OF SCRIPT
// =============================================================================
